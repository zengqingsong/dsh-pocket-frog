{
  "name": "dsh-pocket-frog",
  "version": "2.10.6",
  "description": "手机同屏 · Put DeepSeek Harness in your pocket: scan a QR code and drive the dsh web UI on your computer from your phone, over LAN or the public internet, live.",
  "license": "GPL-2.0",
  "author": "曾青松 <pypzengqs@126.com> (https://github.com/zengqingsong)",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "remote",
    "qr",
    "tunnel"
  ],
  "main": "lib/index.js",
  "bin": {
    "dsh-pocket-frog": "bin/dsh-pocket-frog.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengqingsong/dsh-pocket-frog.git"
  },
  "homepage": "https://github.com/zengqingsong/dsh-pocket-frog",
  "bugs": {
    "url": "https://github.com/zengqingsong/dsh-pocket-frog/issues"
  },
  "scripts": {
    "build:client": "node client/build.mjs",
    "release": "semantic-release",
    "test": "node --test --test-timeout=30000 \"test/*.test.js\"",
    "test:local": "node --test --test-timeout=300000 \"test/local/*.test.js\""
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "esbuild": "^0.25.9",
    "semantic-release": "^24.2.9",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-session-log-export"
      ],
      "platform": "web"
    }
  }
}
